<?xml version="1.0" encoding="utf-8"?>
<!-- In-app Geode logo v5 (v0.1.10) — the full locked G as JS drew it, dark
     rounded tile included, so it reads identically in light and dark mode
     (white strokes would vanish on a light background without the tile).
     Same geometry as ic_launcher_foreground.xml + the #171717 tile
     (72,72, 368x368, rx 112) from ~/workspace/reelnotes/geode-g-logo.svg.
     Used on the Welcome screen (and anywhere else the mark appears in-app);
     the launcher uses ic_launcher_foreground.xml instead, since the adaptive
     icon supplies its own black background. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <path
        android:fillColor="#171717"
        android:pathData="M184,72 L328,72 A112,112 0 0 1 440,184 L440,328 A112,112 0 0 1 328,440 L184,440 A112,112 0 0 1 72,328 L72,184 A112,112 0 0 1 184,72 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="34"
        android:strokeLineCap="round"
        android:pathData="M318.0,148.6 A124,124 0 1 0 380,256" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="28"
        android:strokeLineCap="round"
        android:pathData="M256,194 C222,194 194,222 194,256 C194,290 222,318 256,318" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#A78BFA"
        android:strokeWidth="34"
        android:strokeLineCap="round"
        android:pathData="M380,256 L310,256" />
</vector>
